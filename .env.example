# Copy to .env and fill in. These are read by the server-side API route only,
# so they never ship inside the app bundle.
OPENAI_API_KEY=sk-your-key-here
# Any OpenAI chat model id. gpt-4o-mini is cheap and fast for prototyping.
OPENAI_MODEL=gpt-4o-mini
# Model used for AI avatar generation (/api/avatar).
OPENAI_IMAGE_MODEL=gpt-image-1

# Comma-separated access codes, one per person, at least 24 random characters.
# The server refuses every request until this is set. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_ACCESS_CODES=
# Private, persistent folder for sync and the gallery. Those two features stay
# off until this is set.
DATA_DIR=

# The one public value: where installed apps reach the deployed API routes.
# Required for native builds, and baked into the app at build time.
EXPO_PUBLIC_API_URL=https://your-server.example.com
